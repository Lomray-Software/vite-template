    "axios": "^1.13.6",
    "classnames": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "isbot": "^5.1.36",
    "js-cookie": "^3.0.5",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
