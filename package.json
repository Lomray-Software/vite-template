    "react-i18next": "^17.0.13",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lomray/eslint-config-react": "^7.0.0",
    "@lomray/prettier-config": "^3.0.0",
    "@lomray/stylelint-config": "^3.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
