{
  "name": "@lomray/vite-template",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "develop": "ssr-boost dev",
    "build": "ssr-boost build",
    "build:spa": "ssr-boost build --focus-only client",
    "build:amplify": "ssr-boost build-amplify --is-optimize",
    "build:vercel": "ssr-boost build-vercel --is-optimize",
    "start:ssr": "ssr-boost start",
    "start:spa": "ssr-boost start --focus-only client",
    "preview": "ssr-boost preview",
    "smoke": "node scripts/smoke.mjs",
    "lint:check": "eslint \"src/**/*.{ts,tsx,*.ts,*tsx}\" --max-warnings=0",
    "lint:format": "eslint --fix \"src/**/*.{ts,tsx,*.ts,*tsx}\"",
    "style:check": "stylelint \"src/**/*.{css,scss}\"",
    "style:format": "stylelint --fix \"src/**/*.{css,scss}\"",
    "ts:check": "tsc --project ./tsconfig.json --skipLibCheck --noemit",
    "prepare": "husky",
    "size:check": "node scripts/size-budget.mjs"
  },
  "dependencies": {
    "@lomray/consistent-suspense": "^2.0.9",
    "@lomray/react-head-manager": "^2.2.0",
    "@lomray/react-mobx-manager": "^4.5.1",
    "@lomray/react-route-manager": "^2.0.0",
    "@lomray/vite-ssr-boost": "^8.3.0",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "isbot": "^5.2.2",
    "js-cookie": "^3.0.8",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lomray/eslint-config-react": "^7.0.0",
    "@lomray/prettier-config": "^3.0.0",
    "@lomray/stylelint-config": "^3.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-devtools-json": "^1.1.0"
  }
}
