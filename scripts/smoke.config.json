{
  "routes": [
    {
      "path": "/",
      "status": 200,
      "contains": ["Minimal SSR example", "window.__staticRouterHydrationData"]
    },
    {
      "path": "/deferred",
      "status": 200,
      "contains": ["Deferred data"],
      "containsAny": ["Loading users with Await", "Ada Lovelace"]
    },
    {
      "path": "/users",
      "status": 200,
      "contains": ["Ada Lovelace"]
    },
    {
      "path": "/users/2",
      "status": 200,
      "contains": ["<h1>Grace Hopper</h1>"]
    },
    {
      "path": "/kv",
      "status": 200,
      "contains": ["KV message", "No greeting in KV yet."]
    },
    {
      "path": "/users/999",
      "status": 404
    },
    {
      "path": "/about",
      "status": 200,
      "contains": ["rel=\"stylesheet\"", "/assets/about-"]
    },
    {
      "path": "/redirect",
      "status": 301
    },
    {
      "path": "/client-only",
      "status": 200
    },
    {
      "path": "/missing",
      "status": 404
    }
  ],
  "streamPath": "/about",
  "crawlerCookie": "isCrawler=1",
  "crawlerRoutes": [
    {
      "path": "/deferred",
      "contains": ["<li>Ada Lovelace</li>", "<li>Grace Hopper</li>", "<li>Margaret Hamilton</li>"]
    }
  ],
  "worker": {
    "streamPath": "/deferred",
    "resolveFrames": 1,
    "kvMessage": "Hello from local Worker KV"
  }
}
